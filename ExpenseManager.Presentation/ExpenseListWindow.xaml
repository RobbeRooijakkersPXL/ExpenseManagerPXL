<Window x:Class="ExpenseManager.Presentation.ExpenseListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ExpenseManager"
        Height="540"
        Width="950"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP: MONTH TOTAL -->
        <TextBlock x:Name="monthTotalTextBlock"
                   Grid.Row="0" Grid.ColumnSpan="2"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- LEFT: LIST -->
        <GroupBox Header="Expenses" Grid.Column="0" Grid.Row="1" Margin="0,0,10,10">
            <Grid Margin="10">
                <ListBox x:Name="expensesListBox"
                         SelectionChanged="ExpensesListBox_SelectionChanged"/>
            </Grid>
        </GroupBox>

        <!-- RIGHT: DETAILS -->
        <GroupBox Header="Details" Grid.Column="1" Grid.Row="1" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Description:" FontWeight="Bold" Margin="0,0,10,10"/>
                <TextBlock x:Name="descriptionTextBlock" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Amount:" FontWeight="Bold" Margin="0,0,10,10"/>
                <TextBlock x:Name="amountTextBlock" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Date:" FontWeight="Bold" Margin="0,0,10,10"/>
                <TextBlock x:Name="dateTextBlock" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Category:" FontWeight="Bold" Margin="0,0,10,10"/>
                <TextBlock x:Name="categoryTextBlock" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Reimbursed:" FontWeight="Bold" Margin="0,0,10,10"/>
                <TextBlock x:Name="reimbursedTextBlock" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Reimbursed at:" FontWeight="Bold" Margin="0,0,10,10"/>
                <TextBlock x:Name="reimbursedAtTextBlock" Grid.Row="5" Grid.Column="1" Margin="0,0,0,10"/>
            </Grid>
        </GroupBox>

        <!-- BOTTOM BUTTONS -->
        <StackPanel Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="addButton" Content="Add" Width="110" Margin="0,0,10,0" Padding="5" Click="AddButton_Click"/>
            <Button x:Name="reimburseButton" Content="Reimburse" Width="110" Margin="0,0,10,0" Padding="5" Click="ReimburseButton_Click"/>
            <Button x:Name="deleteButton" Content="Delete" Width="110" Margin="0,0,10,0" Padding="5" Click="DeleteButton_Click"/>
            <Button x:Name="refreshButton" Content="Refresh" Width="110" Padding="5" Click="RefreshButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
